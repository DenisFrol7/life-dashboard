  left join content_seasons s on s.content_id = c.id
  left join content_episodes e on e.season_id = s.id
  left join episode_watch_history w on w.episode_id = e.id and w.user_id = ?
 where c.item_type = ?
 group by c.id, uc.id
 order by c.title

